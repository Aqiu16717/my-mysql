#
# Test MDL diagnostic logging (WL multi-version-metadata Phase 1)
# Covers: mdl_log_level sys_var, WAIT/TIMEOUT/DEADLOCK log output
#
CALL mtr.add_suppression("Can't find error-message file");
CALL mtr.add_suppression("Missing data directory for ICU regular expressions");
# Test 1: sys_var default and validation
SELECT @@global.mdl_log_level;
@@global.mdl_log_level
0
SET @@global.mdl_log_level = 1;
SELECT @@global.mdl_log_level;
@@global.mdl_log_level
1
SET @@global.mdl_log_level = 2;
SELECT @@global.mdl_log_level;
@@global.mdl_log_level
2
SET @@global.mdl_log_level = 0;
SELECT @@global.mdl_log_level;
@@global.mdl_log_level
0
# Verify SET PERSIST works
SET PERSIST mdl_log_level = 1;
SELECT @@global.mdl_log_level;
@@global.mdl_log_level
1
SET PERSIST mdl_log_level = DEFAULT;
SELECT @@global.mdl_log_level;
@@global.mdl_log_level
0
SET @@global.mdl_log_level = 3;
Warnings:
Warning	1292	Truncated incorrect mdl_log_level value: '3'
SELECT @@global.mdl_log_level;
@@global.mdl_log_level
2
SET @@global.mdl_log_level = -1;
Warnings:
Warning	1292	Truncated incorrect mdl_log_level value: '-1'
SELECT @@global.mdl_log_level;
@@global.mdl_log_level
0
#
# Test 2: MDL WAIT/TIMEOUT logging (level 1)
#
SET @@global.mdl_log_level = 1;
CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(100));
INSERT INTO t1 VALUES (1, 'hello'), (2, 'world');
# Connection con1: hold MDL_SW on t1 with open transaction
START TRANSACTION;
INSERT INTO t1 VALUES (3, 'from_con1');
# Connection default: DDL on t1 should timeout due to con1's lock
SET SESSION lock_wait_timeout = 1;
ALTER TABLE t1 ADD COLUMN c INT;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
# Release con1's lock
ROLLBACK;
DROP TABLE t1;
#
# Test 3: MDL DEADLOCK logging (level 1)
#
CREATE TABLE t1 (a INT PRIMARY KEY);
CREATE TABLE t2 (a INT PRIMARY KEY);
# Connection con1: hold MDL_SW on t1
START TRANSACTION;
INSERT INTO t1 VALUES (1);
# Connection con2: hold MDL_SW on t2
START TRANSACTION;
INSERT INTO t2 VALUES (1);
# Create cross-lock: con1 wants t2, con2 wants t1
INSERT INTO t2 VALUES (2);
INSERT INTO t1 VALUES (2);
# Wait for deadlock resolution
DROP TABLE t1, t2;
#
# Test 4: MDL RELEASE logging (level 2)
#
SET @@global.mdl_log_level = 2;
CREATE TABLE t3 (a INT);
INSERT INTO t3 VALUES (1);
DROP TABLE t3;
SET @@global.mdl_log_level = 0;
#
# Test 5: Verify log output in error log
# (Manual verification: grep '\[MDL\]' <error_log>)
#
# Test complete. Check error log for [MDL] prefixed messages.
# Expected: WAIT, TIMEOUT, DEADLOCK at level 1; RELEASE at level 2.
