#
# Transactional DDL — full coverage
#
CREATE DATABASE IF NOT EXISTS test;
USE test;
# Test 1: CREATE TABLE + COMMIT/ROLLBACK
BEGIN;
CREATE TABLE t1 (a INT PRIMARY KEY) START TRANSACTION;
INSERT INTO t1 VALUES (1), (2);
COMMIT;
SELECT COUNT(*) FROM t1;
COUNT(*)
2
BEGIN;
CREATE TABLE t2 (a INT PRIMARY KEY) START TRANSACTION;
ROLLBACK;
SELECT COUNT(*) FROM t2;
ERROR 42S02: Table 'test.t2' doesn't exist
# Test 2: ALTER TABLE ADD COLUMN + ROLLBACK
BEGIN;
ALTER TABLE t1 ADD COLUMN b INT START TRANSACTION;
UPDATE t1 SET b = a * 10;
ROLLBACK;
SELECT b FROM t1 LIMIT 1;
ERROR 42S22: Unknown column 'b' in 'field list'
# Test 3: DROP TABLE + ROLLBACK
CREATE TABLE t3 (a INT);
INSERT INTO t3 VALUES (1);
BEGIN;
DROP TABLE t3 START TRANSACTION;
ROLLBACK;
SELECT COUNT(*) FROM t3;
COUNT(*)
1
DROP TABLE t3;
# Test 4: TRUNCATE + ROLLBACK
CREATE TABLE t4 (a INT);
INSERT INTO t4 VALUES (1),(2),(3);
BEGIN;
TRUNCATE TABLE t4 START TRANSACTION;
ROLLBACK;
SELECT COUNT(*) FROM t4;
COUNT(*)
3
DROP TABLE t4;
# Test 5: CREATE INDEX + ROLLBACK
CREATE TABLE t5 (a INT, b INT);
INSERT INTO t5 VALUES (1,10);
BEGIN;
CREATE INDEX idx5 ON t5(b) START TRANSACTION;
ROLLBACK;
DROP INDEX idx5 ON t5;
ERROR 42000: Can't DROP 'idx5'; check that column/key exists
DROP TABLE t5;
# Test 6: SAVEPOINT + DDL
CREATE TABLE t6 (a INT);
INSERT INTO t6 VALUES (1);
BEGIN;
ALTER TABLE t6 ADD COLUMN x INT START TRANSACTION;
SAVEPOINT sp1;
ALTER TABLE t6 ADD COLUMN y INT START TRANSACTION;
ROLLBACK TO sp1;
SELECT * FROM t6;
a	x
1	NULL
SELECT y FROM t6 LIMIT 1;
ERROR 42S22: Unknown column 'y' in 'field list'
DROP TABLE t6;
# Test 7: RENAME TABLE + ROLLBACK
CREATE TABLE t7 (a INT);
INSERT INTO t7 VALUES (1);
BEGIN;
RENAME TABLE t7 TO t7_new START TRANSACTION;
ROLLBACK;
SELECT COUNT(*) FROM t7;
COUNT(*)
1
SELECT COUNT(*) FROM t7_new;
ERROR 42S02: Table 'test.t7_new' doesn't exist
DROP TABLE t7;
# Test 8: Error — unsupported engine
SET SESSION default_storage_engine = MyISAM;
CREATE TABLE t_bad (a INT) START TRANSACTION;
ERROR HY000: This feature is not allowed with START TRANSACTION
SET SESSION default_storage_engine = InnoDB;
DROP TABLE IF EXISTS t1, t2, t3, t4, t5, t6, t7;
