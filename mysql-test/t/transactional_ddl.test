#
# Test Transactional DDL Phase 1 - minimum viable test
#
CALL mtr.add_suppression("Can't find error-message file");
CALL mtr.add_suppression("Missing data directory for ICU regular expressions");

--echo # Test 1: CREATE TABLE in explicit transaction, commit
BEGIN;
CREATE TABLE t1 (a INT PRIMARY KEY) START TRANSACTION;
COMMIT;
--replace_column 1 #
SELECT COUNT(*) FROM t1;
DROP TABLE t1;

--echo # Test 2: CREATE TABLE in explicit transaction, rollback
BEGIN;
CREATE TABLE t2 (a INT PRIMARY KEY) START TRANSACTION;
ROLLBACK;
--error ER_NO_SUCH_TABLE
SELECT * FROM t2;
