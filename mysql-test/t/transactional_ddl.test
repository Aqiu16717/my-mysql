#
# Test Transactional DDL — Full coverage
#
CALL mtr.add_suppression("Can't find error-message file");
CALL mtr.add_suppression("Missing data directory for ICU regular expressions");

--echo # === CREATE TABLE commit/rollback ===
BEGIN;
CREATE TABLE t_create (a INT PRIMARY KEY) START TRANSACTION;
INSERT INTO t_create VALUES (1);
COMMIT;
SELECT COUNT(*) FROM t_create;
DROP TABLE t_create;

BEGIN;
CREATE TABLE t_create_rb (a INT PRIMARY KEY) START TRANSACTION;
ROLLBACK;
--error ER_NO_SUCH_TABLE
SELECT * FROM t_create_rb;

--echo # === ALTER TABLE commit/rollback ===
CREATE TABLE t_alter (a INT PRIMARY KEY);
INSERT INTO t_alter VALUES (1);
BEGIN;
ALTER TABLE t_alter ADD COLUMN b VARCHAR(100) START TRANSACTION;
COMMIT;
SHOW COLUMNS FROM t_alter LIKE 'b';
DROP TABLE t_alter;

CREATE TABLE t_alter_rb (a INT PRIMARY KEY);
BEGIN;
ALTER TABLE t_alter_rb ADD COLUMN c INT START TRANSACTION;
ROLLBACK;
SHOW COLUMNS FROM t_alter_rb;
DROP TABLE t_alter_rb;

--echo # === DROP TABLE commit/rollback ===
CREATE TABLE t_drop (a INT);
BEGIN;
DROP TABLE t_drop START TRANSACTION;
COMMIT;
--error ER_NO_SUCH_TABLE
SELECT * FROM t_drop;

CREATE TABLE t_drop_rb (a INT);
BEGIN;
DROP TABLE t_drop_rb START TRANSACTION;
ROLLBACK;
SELECT COUNT(*) FROM t_drop_rb;
DROP TABLE t_drop_rb;

--echo # === TRUNCATE commit/rollback ===
CREATE TABLE t_trunc (a INT);
INSERT INTO t_trunc VALUES (1),(2),(3);
BEGIN;
TRUNCATE TABLE t_trunc START TRANSACTION;
COMMIT;
SELECT COUNT(*) FROM t_trunc;
DROP TABLE t_trunc;

CREATE TABLE t_trunc_rb (a INT);
INSERT INTO t_trunc_rb VALUES (1),(2),(3);
BEGIN;
TRUNCATE TABLE t_trunc_rb START TRANSACTION;
ROLLBACK;
SELECT COUNT(*) FROM t_trunc_rb;
DROP TABLE t_trunc_rb;

--echo # === Multi-DDL commit/rollback ===
BEGIN;
CREATE TABLE t_m1 (a INT) START TRANSACTION;
CREATE TABLE t_m2 (a INT) START TRANSACTION;
COMMIT;
SELECT COUNT(*) FROM t_m1;
SELECT COUNT(*) FROM t_m2;
DROP TABLE t_m1, t_m2;

BEGIN;
CREATE TABLE t_mr1 (a INT) START TRANSACTION;
CREATE TABLE t_mr2 (a INT) START TRANSACTION;
ROLLBACK;
--error ER_NO_SUCH_TABLE
SELECT * FROM t_mr1;

--echo # === CREATE INDEX commit/rollback ===
CREATE TABLE t_idx (a INT, b INT);
INSERT INTO t_idx VALUES (1,10);
BEGIN;
CREATE INDEX idx_a ON t_idx(a) START TRANSACTION;
COMMIT;
SHOW INDEX FROM t_idx;
DROP TABLE t_idx;

CREATE TABLE t_idx_rb (a INT, b INT);
BEGIN;
CREATE INDEX idx_b ON t_idx_rb(b) START TRANSACTION;
ROLLBACK;
SHOW INDEX FROM t_idx_rb;
DROP TABLE t_idx_rb;

--echo # === DROP INDEX commit/rollback ===
CREATE TABLE t_di (a INT, b INT);
CREATE INDEX idx_x ON t_di(b);
BEGIN;
DROP INDEX idx_x ON t_di START TRANSACTION;
COMMIT;
SHOW INDEX FROM t_di;
DROP TABLE t_di;

CREATE TABLE t_di_rb (a INT, b INT);
CREATE INDEX idx_y ON t_di_rb(b);
BEGIN;
DROP INDEX idx_y ON t_di_rb START TRANSACTION;
ROLLBACK;
SHOW INDEX FROM t_di_rb;
DROP TABLE t_di_rb;

--echo # === SAVEPOINT + DDL ===
CREATE TABLE t_sp (a INT PRIMARY KEY);
BEGIN;
CREATE TABLE t_sp_new (a INT) START TRANSACTION;
SAVEPOINT sp1;
ALTER TABLE t_sp_new ADD COLUMN b INT START TRANSACTION;
ROLLBACK TO sp1;
SHOW COLUMNS FROM t_sp_new;
COMMIT;
DROP TABLE t_sp_new;
DROP TABLE t_sp;

--echo # === DDL + DML mixing ===
BEGIN;
CREATE TABLE t_mix (a INT PRIMARY KEY) START TRANSACTION;
INSERT INTO t_mix VALUES (1);
UPDATE t_mix SET a = 2;
DELETE FROM t_mix WHERE a = 2;
INSERT INTO t_mix VALUES (3);
COMMIT;
SELECT COUNT(*) FROM t_mix;
DROP TABLE t_mix;

--echo # === RENAME TABLE commit/rollback ===
CREATE TABLE t_rename (a INT);
BEGIN;
RENAME TABLE t_rename TO t_renamed START TRANSACTION;
COMMIT;
SELECT COUNT(*) FROM t_renamed;
DROP TABLE t_renamed;

CREATE TABLE t_rn_rb (a INT);
BEGIN;
RENAME TABLE t_rn_rb TO t_rn_new START TRANSACTION;
ROLLBACK;
SELECT COUNT(*) FROM t_rn_rb;
--error ER_NO_SUCH_TABLE
SELECT * FROM t_rn_new;
DROP TABLE t_rn_rb;

--echo # === Complete ===
